# API Configuration
VITE_API_BASE_URL=http://localhost:8093/api/v1
VITE_GRAPHQL_URL=http://localhost:8093/graphql

# Application Configuration
VITE_APP_NAME=Plaart
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=LOCAL

# Auth Configuration
VITE_JWT_SECRET_KEY=your-secret-key
